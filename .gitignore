.gradle
**/build/
!**/src/**/build/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignore Gradle wrapper properties
!gradle-wrapper.properties

# Cache of project
.gradletasknamecache

# Eclipse Gradle plugin generated files
# Eclipse Core
.project
# JDT-specific (Eclipse Java Development Tools)
.classpath

# direnv
.direnv/

# Loom run directory
run/

# Zig
.zig-cache/
zig-out/
zig-pkg/

# NVIDIA DLSS SDK, downloaded separately
native/dlss_sdk/

# IDE
.idea/
*.iml
.vscode/
